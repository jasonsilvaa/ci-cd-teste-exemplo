{
  "name": "ci-cd-teste-exemplo",
  "version": "1.0.0",
  "description": "Projeto simples para aulas de CI-CD",
  "main": "index.js",
  "scripts": {
    "test": "npx cypress run --browser chrome",
    "docker:build": "docker build -t ci-cd-teste-exemplo .",
    "docker:run": "docker run --rm ci-cd-teste-exemplo",
    "docker:test": "npm run docker:build && npm run docker:run",
    "report":"npx allure serve --clean allure-results",
    "report:generate":"npx allure generate allure-results -o allure-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EBAC-QE/ci-cd-teste-exemplo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/EBAC-QE/ci-cd-teste-exemplo/issues"
  },
  "homepage": "https://github.com/EBAC-QE/ci-cd-teste-exemplo#readme",
  "dependencies": {
    "cypress": "^14.5.4"
  },
  "devDependencies": {
    "allure-cypress": "^3.9.0"
  }
}
